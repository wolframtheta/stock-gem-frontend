# Copia a `.env` i ajusta. Variables amb prefix NG_APP_ es injecten al bundle (públics, no hi posis secrets).

NG_APP_API_URL=http://localhost:3500/api
NG_APP_UPLOAD_PUBLIC_PATH=/uploads/images
# Opcional: URL base pública per <img> (GET). Ex.: https://estoc.example.com/media/images
# NG_APP_ASSET_PUBLIC_BASE_URL=
NG_APP_PRODUCTION=false
