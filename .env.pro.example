# Copia a `.env.pro` per `pnpm build` (default configuration = production).

NG_APP_API_URL=https://api.example.com/api
NG_APP_UPLOAD_PUBLIC_PATH=/uploads/images
# Base pública per mostrar imatges (pot diferir de l’API si Traefik separa /api i /media)
NG_APP_ASSET_PUBLIC_BASE_URL=https://app.example.com/media/images
NG_APP_PRODUCTION=true
